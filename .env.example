# MongoDB Atlas: copie a URI em Connect > Drivers e substitua usuário/senha.
MONGODB_URI=
MONGODB_DB=minha_receita
# Opcional: use 1.1.1.1,8.8.8.8 se o DNS local recusar consultas SRV do Atlas.
MONGODB_DNS_SERVERS=
SESSION_SECRET=
NODE_ENV=development
PORT=5000

# IA na nuvem: mantenha as contas na modalidade gratuita, sem faturamento.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Alternativa opcional. Só é utilizada se selecionada ou habilitada abaixo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Análise audiovisual: usa a chave Gemini mesmo quando o texto é gerado pelo Groq.
GEMINI_VIDEO_MODEL=gemini-3.5-flash-lite
# Caminhos opcionais. Por padrão, yt-dlp em .tools e FFmpeg instalado pelo npm.
YTDLP_PATH=
FFMPEG_PATH=
# Endpoint gratuito de imagem. Deixe vazio para usar o padrão incorporado.
FREE_IMAGE_API_URL=
# Deixe vazio para não encaminhar pedidos a outro provedor automaticamente.
AI_FALLBACK_PROVIDER=

# Desenvolvimento local: mantenha estes valores vazios.
FRONTEND_URL=
VITE_API_URL=
# Produção com frontend separado: defina false e configure as URLs acima.
SERVE_STATIC=
